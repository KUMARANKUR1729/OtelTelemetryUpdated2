{
  "uid": "otel-browser-signoz",
  "title": "OpenTelemetry: browser overview (SigNoz)",
  "tags": [
    "opentelemetry",
    "browser",
    "signoz"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Grafana on top of SigNoz: reads SigNoz's ClickHouse store directly (traces, logs, metrics).",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "SigNoz source",
        "type": "datasource",
        "query": "grafana-clickhouse-datasource",
        "current": {
          "text": "SigNoz (ClickHouse)",
          "value": "signoz-clickhouse"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "${ds}"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": {
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "refId": "svc",
          "rawSql": "SELECT DISTINCT resources_string['service.name'] FROM signoz_traces.distributed_signoz_index_v3 WHERE timestamp > now() - INTERVAL 1 DAY AND ts_bucket_start >= toUInt64(toUnixTimestamp(now())) - 90000"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Traffic and latency (fetch / XHR spans, exact percentiles)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP requests",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS requests FROM signoz_traces.distributed_signoz_index_v3 WHERE $__timeFilter(timestamp) AND ts_bucket_start >= toUInt64(toUnixTimestamp($__fromTime)) - 1800 AND resources_string['service.name'] IN ($service) AND kind = 3 AND (http_method != '' OR startsWith(name, 'HTTP '))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP error rate",
      "description": "5xx responses and failed calls",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT 100 * countIf(has_error OR toUInt16OrZero(response_status_code) >= 500) / count() AS error_rate FROM signoz_traces.distributed_signoz_index_v3 WHERE $__timeFilter(timestamp) AND ts_bucket_start >= toUInt64(toUnixTimestamp($__fromTime)) - 1800 AND resources_string['service.name'] IN ($service) AND kind = 3 AND (http_method != '' OR startsWith(name, 'HTTP '))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unhandled errors",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS errors FROM signoz_traces.distributed_signoz_index_v3 WHERE $__timeFilter(timestamp) AND ts_bucket_start >= toUInt64(toUnixTimestamp($__fromTime)) - 1800 AND resources_string['service.name'] IN ($service) AND name IN ('browser.error', 'browser.unhandledrejection')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Sessions",
      "description": "Distinct browser sessions that sent spans",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT uniqExact(attributes_string['session.id']) AS sessions FROM signoz_traces.distributed_signoz_index_v3 WHERE $__timeFilter(timestamp) AND ts_bucket_start >= toUInt64(toUnixTimestamp($__fromTime)) - 1800 AND resources_string['service.name'] IN ($service)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request rate by status",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time, if(response_status_code = '', 'failed', response_status_code) AS status, count() / $__interval_s AS rps FROM signoz_traces.distributed_signoz_index_v3 WHERE $__timeFilter(timestamp) AND ts_bucket_start >= toUInt64(toUnixTimestamp($__fromTime)) - 1800 AND resources_string['service.name'] IN ($service) AND kind = 3 AND (http_method != '' OR startsWith(name, 'HTTP ')) GROUP BY time, status ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time, quantile(0.5)(duration_nano) / 1e6 AS p50, quantile(0.95)(duration_nano) / 1e6 AS p95, quantile(0.99)(duration_nano) / 1e6 AS p99 FROM signoz_traces.distributed_signoz_index_v3 WHERE $__timeFilter(timestamp) AND ts_bucket_start >= toUInt64(toUnixTimestamp($__fromTime)) - 1800 AND resources_string['service.name'] IN ($service) AND kind = 3 AND (http_method != '' OR startsWith(name, 'HTTP ')) GROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p95 latency by server",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time, coalesce(nullIf(attributes_string['http.host'], ''), nullIf(attributes_string['server.address'], ''), nullIf(extract(attributes_string['http.url'], '^[a-zA-Z]+://([^/?#]+)'), ''), 'unknown') AS server, quantile(0.95)(duration_nano) / 1e6 AS p95 FROM signoz_traces.distributed_signoz_index_v3 WHERE $__timeFilter(timestamp) AND ts_bucket_start >= toUInt64(toUnixTimestamp($__fromTime)) - 1800 AND resources_string['service.name'] IN ($service) AND kind = 3 AND (http_method != '' OR startsWith(name, 'HTTP ')) GROUP BY time, server ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Slowest requests",
      "description": "Click a trace ID to open it in SigNoz",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT timestamp, trace_id, name, coalesce(nullIf(attributes_string['http.host'], ''), nullIf(attributes_string['server.address'], ''), nullIf(extract(attributes_string['http.url'], '^[a-zA-Z]+://([^/?#]+)'), ''), 'unknown') AS server, response_status_code AS status, duration_nano / 1e6 AS duration_ms FROM signoz_traces.distributed_signoz_index_v3 WHERE $__timeFilter(timestamp) AND ts_bucket_start >= toUInt64(toUnixTimestamp($__fromTime)) - 1800 AND resources_string['service.name'] IN ($service) AND kind = 3 AND (http_method != '' OR startsWith(name, 'HTTP ')) ORDER BY duration_nano DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in SigNoz",
                    "url": "http://localhost:8090/trace/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {}
    },
